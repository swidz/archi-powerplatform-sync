/* Opt-in read-only live test. Every apply targets a new disposable model. */
(function(){
 var root=String(Java.type('java.nio.file.Paths').get(__DIR__).getParent().toAbsolutePath());
 ['core','metadata','auth','http','inventory','dependencies','dataverse','scoped','plugins','context','planner','cli-java','java-runtime','archi-adapter'].forEach(function(f){load(root+'/lib/'+f+'.js');});
 var C=PPCore,System=Java.type('java.lang.System'),envId=C.envId(String(System.getenv('ARCHI_PP_TEST_ENVIRONMENT'))),solutionIds=String(System.getenv('ARCHI_PP_TEST_SOLUTIONS')).split(',').map(C.guid),tableIds=String(System.getenv('ARCHI_PP_TEST_TABLES')).split(',').map(C.guid),checks=[],auth;
 function ok(value,message){C.assert(value,message);checks.push(message);}
 try{
  auth=PPAuth.create(PPCliJava.createIo());var http=PPHttp.create(PPJava.io,auth),env=PPInventory.create(http,auth.tenantId).discover().environments.filter(function(e){return e.id===envId;})[0];
  C.assert(env&&env.available,'Approved test environment is unavailable');var collector=PPScoped.create(http,auth.tenantId,function(s){console.log(s);}),metadata=PPMetadata.create(http),m=$.model.create('Plug-in live test');m.setAsCurrent();
  function collect(requests){var s=collector.collectMany(requests,'plugins',PPArchi.elements(m),{});metadata.enrich(s,[env],{});ok(!s.partial,'Plug-in collection and metadata enrichment completed');return s;}
  function sync(s){var p=PPPlanner.plan(PPArchi.elements(m),PPArchi.relationships(m),s,{},PPArchi.isAllowed);PPArchi.apply(m,p,PPArchi.prepare(m,p));return p;}
  var solutionRequests=solutionIds.map(function(id){return {environment:env,solutionId:id};}),tableRequests=tableIds.map(function(id){return {environment:env,tableId:id};});
  var solutions=collect(solutionRequests);ok(solutions.objects.some(function(o){return o.kind==='plugin';}),'Solution batch discovered real plug-in types');sync(solutions);
  var tables=collect(tableRequests);ok(tables.objects.filter(function(o){return o.kind==='table';}).length===tableIds.length,'Table batch remains within selected table scope');
  ok(tables.edges.some(function(e){return e.type==='access-relationship';}),'Table batch discovered real table-specific registrations');
  ok(tables.objects.filter(function(o){return o.kind==='plugin';}).every(function(o){return Object.keys(o.metadata).some(function(k){return k.indexOf('Assembly-')===0;});}),'Assembly properties are included for live plug-ins');
  ok(tables.objects.filter(function(o){return o.kind==='table';}).every(function(o){return o.metadata['Dataverse-OwnershipType']!==undefined;}),'Extended table metadata is readable');
  sync(tables);var prior={};PPArchi.elements(m).forEach(function(e){prior[e.key]=e.elementId;});
  var repeat=sync(collect(tableRequests));ok(repeat.counts.create===0&&repeat.counts.relationshipsCreate===0,'Repeated table batch creates no duplicate elements or Access links');
  ok(PPArchi.elements(m).every(function(e){return prior[e.key]===e.elementId;}),'Plug-in and table GUIDs remain stable');
  var access=[];$(m).find('relationship').each(function(r){if(String(r.type)==='access-relationship')access.push(r);});
  ok(access.every(function(r){return String(r.accessType)==='access';}),'All live Access relationships retain unspecified read/write semantics');
  var file=root+'/work/plugins-live-smoke.archimate';m.save(file);var loaded=$.model.load(file);
  ok(PPArchi.elements(loaded).length===PPArchi.elements(m).length,'Live plug-in model saves and reloads');
  var counts={};PPArchi.elements(m).forEach(function(e){counts[e.kind]=(counts[e.kind]||0)+1;});
  PPJava.write(root+'/work/plugins-live-smoke-result.json',JSON.stringify({status:'passed',checks:checks,counts:counts,accessRelationships:access.length,relationships:PPArchi.relationships(m).length,metadataProperties:PPArchi.elements(m).reduce(function(n,e){return n+Object.keys(e.properties).filter(function(k){return k.indexOf(C.PREFIX+'Metadata-')===0;}).length;},0)},null,2));
  console.log('POWERPLATFORM_PLUGINS_LIVE_PASSED: '+checks.length);
 }finally{if(auth)auth.clear();}
}());
